{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${contact_homepage}",
    "sources": "${contact_sources}",
    "issues": "${contact_issues}"
  },
  "license": "${license}",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
        "com.gmalvestiti.minecraft.easyconfig.platform.fabric.FabricEntrypoint"
    ]
  },
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${fabric_loader}"
  }
}
